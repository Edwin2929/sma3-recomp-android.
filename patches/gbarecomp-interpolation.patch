     next_ = clock::now() + period_;
 }
 
+bool FramePacer::wait_for_midpoint() {
+    if (uncapped_) return false;
+    const auto deadline = next_ - period_ / 2;
+    if (clock::now() > deadline + std::chrono::microseconds(1000)) return false;
+    const auto sleep_end = deadline - std::chrono::microseconds(300);
+    if (clock::now() < sleep_end) std::this_thread::sleep_until(sleep_end);
+    while (clock::now() < deadline) std::this_thread::yield();
+    return clock::now() < next_ - std::chrono::milliseconds(2);
+}
